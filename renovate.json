{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "packageRules": [
    {
      "matchManagers": [
        "cargo"
      ],
      "rangeStrategy": "bump"
    }
  ],
  "postUpgradeTasks": {
    "commands": [
      "rustup component add rustc-codegen-cranelift-preview --toolchain nightly"
    ],
    "executionMode": "update",
    "installTools": {
      "rust": {}
    }
  },
  "constraints": {
    "rust": "nightly"
  }
}
